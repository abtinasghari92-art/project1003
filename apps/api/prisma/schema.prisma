generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  ZIBAL
  NOWPAYMENTS
}

enum PaymentStatus {
  PENDING
  REDIRECTED
  PAID
  FAILED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELED
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telegram      TelegramIdentity?
  bale          BaleIdentity?
  otpChallenges OtpChallenge[]
  cart          Cart?
  orders        Order[]
  entitlements  Entitlement[]
  notes         CustomerNote[]
}

model TelegramIdentity {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
}

model BaleIdentity {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baleId    String   @unique
  username  String?
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

model Magazine {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  coverUrl    String?
  issues      Issue[]
}

model Issue {
  id           String        @id @default(cuid())
  magazineId   String
  magazine     Magazine      @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  title        String
  number       Int
  priceRial    Int
  pdfKey       String?
  coverUrl     String?
  publishedAt  DateTime?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id      String @id @default(cuid())
  cartId  String
  cart    Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])
  qty     Int    @default(1)

  @@unique([cartId, issueId])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING_PAYMENT)
  amountRial Int
  amountUsd  Decimal?    @db.Decimal(12, 2)
  items      OrderItem[]
  payments   Payment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue  @relation(fields: [issueId], references: [id])
  title     String
  priceRial Int
  qty       Int    @default(1)
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amountRial  Int
  externalId  String?
  redirectUrl String?
  rawPayload  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([externalId])
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
}

enum AdminRole {
  ADMIN
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  notes        CustomerNote[]
}

model CustomerNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
