generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  ZIBAL
  NOWPAYMENTS
}

enum PaymentStatus {
  PENDING
  REDIRECTED
  PAID
  FAILED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELED
}

enum DeliveryMethod {
  POST
  COURIER_TEHRAN
}

model User {
  id         String   @id @default(cuid())
  phone      String?  @unique
  firstName  String?
  lastName   String?
  province   String?
  city       String?
  street     String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  telegram      TelegramIdentity?
  bale          BaleIdentity?
  otpChallenges OtpChallenge[]
  cart          Cart?
  addresses     SavedAddress[]
  orders        Order[]
  entitlements  Entitlement[]
  notes         CustomerNote[]
  comments      Comment[]
  commentVotes  CommentVote[]
  analyticsEvents AnalyticsEvent[]
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("آدرس")
  firstName  String
  lastName   String
  phone      String
  province   String
  city       String
  street     String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isDefault])
}

model TelegramIdentity {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
}

model BaleIdentity {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baleId    String   @unique
  username  String?
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

model Magazine {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  coverUrl    String?
  issues      Issue[]
}

model Issue {
  id           String        @id @default(cuid())
  magazineId   String
  magazine     Magazine      @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  title        String
  number       Int
  priceRial    Int
  originalPriceRial Int?
  pdfKey       String?
  coverUrl     String?
  publishedAt  DateTime?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  comments     Comment[]
  analyticsEvents AnalyticsEvent[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id      String @id @default(cuid())
  cartId  String
  cart    Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])
  qty     Int    @default(1)

  @@unique([cartId, issueId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  status       OrderStatus @default(PENDING_PAYMENT)
  amountRial   Int
  amountUsd    Decimal?    @db.Decimal(12, 2)
  shippingRial Int         @default(0)
  deliveryMethod DeliveryMethod @default(POST)
  firstName    String?
  lastName     String?
  province     String?
  city         String?
  street       String?
  postalCode   String?
  phone        String?
  notes        String?
  items        OrderItem[]
  payments     Payment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model DeliverySettings {
  id                   String   @id @default("global")
  postShippingRial     Int      @default(70000)
  courierTehranEnabled Boolean  @default(false)
  courierTehranRial    Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue  @relation(fields: [issueId], references: [id])
  title     String
  priceRial Int
  qty       Int    @default(1)
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  channel     String?
  amountRial  Int
  externalId  String?
  redirectUrl String?
  rawPayload  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([externalId])
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
}

enum AdminRole {
  ADMIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommentVoteValue {
  UP
  DOWN
}

enum AnalyticsChannel {
  TELEGRAM
  BALE
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  notes        CustomerNote[]
  commentReplies Comment[] @relation("CommentReplies")
  notifications AdminNotification[]
  auditLogs     AdminAuditLog[]
  reports       ReportSnapshot[]
}

model CustomerNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id          String        @id @default(cuid())
  issueId     String
  issue       Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName   String?
  submissionKey String?
  body        String
  stars       Int           @default(5)
  status      CommentStatus @default(PENDING)
  adminReply  String?
  repliedById String?
  repliedBy   AdminUser?    @relation("CommentReplies", fields: [repliedById], references: [id], onDelete: SetNull)
  helpfulUp   Int           @default(0)
  helpfulDown Int           @default(0)
  moderatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  votes       CommentVote[]

  @@index([issueId, status, createdAt])
  @@index([status, createdAt])
  @@index([submissionKey, createdAt])
}

model CommentVote {
  id        String           @id @default(cuid())
  commentId String
  comment   Comment          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey  String
  value     CommentVoteValue
  createdAt DateTime         @default(now())

  @@unique([commentId, voterKey])
  @@index([commentId, createdAt])
}

model AnalyticsEvent {
  id         String           @id @default(cuid())
  eventId    String           @unique
  channel    AnalyticsChannel
  name       String
  sessionId  String
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  issueId    String?
  issue      Issue?           @relation(fields: [issueId], references: [id], onDelete: SetNull)
  path       String
  metadata   Json?
  occurredAt DateTime         @default(now())

  @@index([channel, occurredAt])
  @@index([name, occurredAt])
  @@index([issueId, occurredAt])
  @@index([sessionId, occurredAt])
}

model ReportSnapshot {
  id          String            @id @default(cuid())
  periodType  String
  from        DateTime
  to          DateTime
  channel     AnalyticsChannel?
  summary     Json
  createdById String
  createdBy   AdminUser         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([createdAt])
  @@index([from, to])
}

model AdminNotification {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, readAt, createdAt])
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model PromotionCampaign {
  id              String   @id @default("global")
  active          Boolean  @default(false)
  code            String   @default("")
  discountPercent Int      @default(0)
  title           String   @default("هدیه برای شما")
  description     String   @default("")
  updatedAt       DateTime @updatedAt
}
