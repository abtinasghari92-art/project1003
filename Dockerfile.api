FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
RUN echo "package-import-method=copy" > .npmrc

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api ./apps/api
COPY packages/types ./packages/types
COPY packages/utils ./packages/utils

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @majara/types build
RUN pnpm --filter @majara/utils build
RUN pnpm --filter @majara/api prisma:generate \
  && GEN=$(find /app/node_modules -type d -path '*/.prisma/client' | head -n 1) \
  && echo "generated prisma client: $GEN" \
  && test -n "$GEN" \
  && test -f "$GEN/default.js" \
  && mkdir -p /app/node_modules/.prisma \
  && rm -rf /app/node_modules/.prisma/client \
  && cp -a "$GEN" /app/node_modules/.prisma/client
RUN pnpm --filter @majara/api build

ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000
WORKDIR /app
CMD ["sh", "-c", "pnpm --filter @majara/api exec prisma migrate deploy && node /app/apps/api/dist/main.js"]
