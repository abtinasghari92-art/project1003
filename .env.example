# Core
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (local docker-compose)
DATABASE_URL=postgresql://majara:majara@localhost:5432/majara?schema=public

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=majara_bot
TELEGRAM_WEBHOOK_SECRET=change-me

# Bale
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=majara_bot
BALE_WEBHOOK_SECRET=change-me

# Kavenegar OTP
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
OTP_PEPPER=change-me-otp-pepper
OTP_TTL_SECONDS=120

# Zibal (use merchant=zibal for sandbox)
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost:4000/payments/zibal/callback
ZIBAL_GATEWAY_BASE=https://gateway.zibal.ir

# NowPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io
NOWPAYMENTS_IPN_URL=http://localhost:4000/payments/nowpayments/ipn
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
USD_TO_IRR_RATE=800000

# Frontend return URLs after payment
TELEGRAM_WEB_URL=http://localhost:3000
BALE_WEB_URL=http://localhost:3001

# Liara Object Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Sentry (optional)
SENTRY_DSN=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=majara_bot
NEXT_PUBLIC_BALE_BOT_USERNAME=majara_bot
NEXT_PUBLIC_FOOTER_AD_HREF=
NEXT_PUBLIC_SENTRY_DSN=
